# 복사해서 사용:  cp .env.example .env  &&  set -a && . ./.env && set +a
# .env 는 .gitignore 에 포함되어 있다.

# --- API 토큰 (소스에 하드코딩 금지) -----------------------------------
# Llama 등 gated 모델 다운로드에 필요
HF_TOKEN=

# --- 경로 (미지정 시 저장소 안의 results/ 를 사용) ---------------------
# 산출물이 수 GB 쌓이므로 저장소 밖을 가리키게 하는 것을 권장
# UQ_RESULTS_DIR=/mnt/data/uq/results_vllm
# DPR_DATA_DIR=/mnt/data/DPR/dpr/data/downloads/data
